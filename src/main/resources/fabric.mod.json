{
	"schemaVersion": 1,
	"id": "overstackedfixes",
	"version": "${version}",
	"name": "Overstacked Fixes",
	"description": "Supplies various fixes for overstacked items, reimplementing old functionality, and adding new functionality, all in a highly configurable way.",
	"authors": [
		"smugsenkopdn / pifire / senkowo / Joncar66"
	],
	"contact": {
		"sources": "https://github.com/smugsenkopdn/OverstackedFixes"
	},
	"license": "MIT",
	"icon": "assets/overstackedfixes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pifire.overstackedfixes.OverstackedFixes"
		],
		"fabric-datagen": [
			"pifire.overstackedfixes.OverstackedFixesDataGenerator"
		],
        "client": [
            "pifire.overstackedfixes.OverstackedFixesClient"
        ],
        "modmenu": [
            "pifire.overstackedfixes.integrations.ModMenuIntegration"
        ]
	},
	"mixins": [
		"overstackedfixes.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
        "fabric-api": "*",
		"minecraft": "~1.21.1",
		"java": ">=21",
        "modmenu": ">=11.0.4",
        "cloth-config": "*",
        "yet_another_config_lib_v3": "*"
    }
}